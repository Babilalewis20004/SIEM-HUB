SECRET_KEY=change-me-in-production
# Leave DATABASE_URL unset to use the sqlite default in config.py. If you set
# it yourself, prefer an absolute path (sqlite:////absolute/path/siem.db) or a
# real DB URL (e.g. Postgres) -- a relative sqlite:/// path gets resolved
# against Flask's instance folder, which silently creates a second,
# out-of-sync database file next to the one config.py's default uses.
# DATABASE_URL=sqlite:///siem.db
CORS_ORIGINS=http://localhost:5173

JWT_SECRET_KEY=change-me-in-production-too
JWT_EXPIRATION_HOURS=12
REQUIRE_AUTH=true
